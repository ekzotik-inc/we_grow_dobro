# --- обязательно ---
BOT_TOKEN=123456:ABC-DEF...            # токен от @BotFather
ADMIN_IDS=111111111,222222222          # Telegram id сотрудников P&C (узнать: @userinfobot)

# --- каналы модерации (можно подключить прямо в /admin → Каналы и настройки) ---
REG_CHANNEL_ID=            # канал заявок: -1001234567890 (бот должен быть админом канала)
RESULTS_CHANNEL_ID=        # канал результатов: -1009876543210

# --- Web App (Telegram требует HTTPS-адрес) ---
WEBAPP_URL=https://marathon.example.com   # пусто = кнопка приложения скрыта, бот работает без неё
WEB_HOST=0.0.0.0
WEB_PORT=8080

# --- база: по умолчанию SQLite в ./data/marathon.db ---
DATABASE_URL=sqlite+aiosqlite:///./data/marathon.db

# --- марафон ---
TZ=Asia/Almaty
TEAM_SIZE=5
MARATHON_TITLE=Марафон добрых дел «We Grow Dobro»
PC_CONTACT=Дарья (P&C)
WEEK1_START=2026-09-09
WEEK1_END=2026-09-15
WEEK2_START=2026-09-16
WEEK2_END=2026-09-22
WEEK3_START=2026-09-23
WEEK3_END=2026-09-30
ANNOUNCE_HOUR=10      # час автоанонса заданий в первый день недели
REMINDER_HOUR=12      # час напоминания за день до дедлайна тем, у кого 0 отчётов
FORCE_WEEK=0          # для тестов до старта: 1/2/3 принудительно открывает неделю
